  &lt;a data-fancybox=&#34;&#34; href=&#34;https://fxy5750.github.io/tool/mkdocs/tool/mkdocs/media/%e5%bf%ab%e9%80%9f%e8%8e%b7%e5%8f%96%e5%af%b9%e6%af%94%e5%ba%a6.jpg&#34; data-caption=&#34;快速获取对比度&#34;&gt;


  &lt;img src=&#34;https://fxy5750.github.io/tool/mkdocs/tool/mkdocs/media/%e5%bf%ab%e9%80%9f%e8%8e%b7%e5%8f%96%e5%af%b9%e6%af%94%e5%ba%a6.jpg&#34; alt=&#34;&#34;  &gt;
